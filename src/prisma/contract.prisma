// use prisma-8

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  name        String?
  bio         String?
  followers   Int
  following   Int
  public_repos Int  
  account_created_at  TimestamptzString
  email       String?

  CreatedAt   TimestamptzString @default(now())
  UpdatedAt temporal.updatedAtString()
}
