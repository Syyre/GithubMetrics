// use prisma-8

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  name        String?
  bio         String?
  followers   Int
  following   Int
  public_repos Int
  commits_last_30_days Int
  account_created_at  TimestamptzString
  email       String?
  repositoriesUpdatedAt TimestamptzString?

  repositories Repository[]

  CreatedAt   TimestamptzString @default(now())
  UpdatedAt temporal.updatedAtString()
}


model Repository {
  id          Int      @id @default(autoincrement())
 
  name        String
  description String?
  url         String
  PrimaryLanguage    String?
  stars       Int
  forks       Int
  repository_created_at  TimestamptzString
  repository_updated_at  TimestamptzString
  languages   RepositoryLanguage[]
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])

  CreatedAt   TimestamptzString @default(now())
  UpdatedAt temporal.updatedAtString()
}

model RepositoryLanguage {
  // id          Int      @id @default(autoincrement())
  language     String   
  bytes      Int
  // repositories Repository[]
  repositoryId Int

  repository   Repository @relation(fields: [repositoryId], references: [id])

  CreatedAt   TimestamptzString @default(now())
  UpdatedAt temporal.updatedAtString()

  @@id([language, repositoryId])
}