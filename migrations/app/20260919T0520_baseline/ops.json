    ],
    "execute": [
      {
        "description": "add unique constraint \"user_githubId_key\"",
        "sql": "ALTER TABLE \"public\".\"user\" ADD CONSTRAINT \"user_githubId_key\" UNIQUE (\"githubId\")"
