    ],
    "execute": [
      {
        "description": "create table \"user\"",
        "sql": "CREATE TABLE \"public\".\"user\" (\n  \"CreatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"PublicRepos\" int4 NOT NULL,\n  \"UpdatedAt\" timestamptz NOT NULL,\n  \"followers\" int4 NOT NULL,\n  \"following\" int4 NOT NULL,\n  \"githubId\" int4 NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"name\" text NOT NULL,\n  \"username\" text NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"user\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"user\""
        ]
      }
    ]
  },
